# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored. No secrets belong in version control.

# Local PostgreSQL connection (ADR-2).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/penguwave

# Comma-separated CORS whitelist (ADR-7). The frontend dev server origin.
CORS_ORIGINS=http://localhost:5173

# JWT signing key (ADR-3). REQUIRED for auth. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to true only when served over HTTPS (production).
COOKIE_SECURE=false

# Seed credentials (used by `python -m app.seed`). Never commit real values.
SEED_ADMIN_EMAIL=admin@penguwave.io
SEED_ADMIN_PASSWORD=
SEED_VIEWER_EMAIL=viewer@penguwave.io
SEED_VIEWER_PASSWORD=
